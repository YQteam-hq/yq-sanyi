{
  "name": "@yq-sanyi/accessibility",
  "version": "0.1.0",
  "description": "Accessibility utilities and ARIA enhancements for yq-sanyi components",
  "type": "module",
  "main": "./dist/accessibility.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --format=esm --target=es2019 --outfile=dist/accessibility.mjs",
