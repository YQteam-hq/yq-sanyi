{
  "name": "@yq-sanyi/animation-utils",
  "version": "0.4.2",
  "description": "Animation and transition utilities for yq-sanyi components",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --format=esm --target=es2019 --outfile=dist/index.mjs && esbuild src/index.ts --bundle --minify --format=cjs --target=es2019 --outfile=dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "yq-sanyi",
    "animation",
    "transitions",
    "components",
    "web-components",
    "animation-utilities"
  ],
  "author": "YQteam-hq",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/YQteam-hq/yq-sanyi.git"
  },
  "homepage": "https://github.com/YQteam-hq/yq-sanyi#readme",
  "engines": {
    "node": ">=18.17"
  }
}